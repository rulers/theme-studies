{
  "name": "theme-studies",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Five interactive Next.js themes with scroll-driven WebGL transitions.",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "test": "node --test tests/*.test.js",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier --write \"{app,components,hooks,lib,tests}/**/*.{js,jsx,css}\" \"*.{json,mjs}\"",
    "format:check": "prettier --check \"{app,components,hooks,lib,tests}/**/*.{js,jsx,css}\" \"*.{json,mjs}\"",
    "check": "npm run lint && npm run format:check && npm test"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.2",
    "prettier": "^3.6.2"
  }
}
